---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import MarkedText from '../MarkedText.astro';
import { fakten, site } from '../../data/site';

const ueber = await getEntry('ueber', 'philipp-kremer');
if (!ueber) throw new Error('src/content/ueber/philipp-kremer.md fehlt');
const { foto, fotoAlt, einleitung, text, markierung } = ueber.data;
---

<!-- Foto | Überschrift und Text | Eckdaten; ohne Foto: Text | Eckdaten -->
<section class="section" id="ueber" aria-labelledby="ueber-title">
  <div class="wrap">
    <div class:list={['about', { 'has-portrait': foto }]}>
      {
        foto && (
          <figure class="portrait">
            <Image src={foto} alt={fotoAlt} widths={[320, 480, 640]} sizes="(max-width: 860px) 320px, 290px" loading="lazy" />
          </figure>
        )
      }
      <div class="about-body">
        <h2 id="ueber-title">{site.founder.name},<br />{site.founder.jobTitle}<br />von {site.name}.</h2>
        <p class="lede">{einleitung}</p>
        <p class="about-text"><MarkedText text={text} markierung={markierung} /></p>
      </div>
      <div class="facts">
        {fakten.map(([key, value]) => <div><span>{key}</span><span>{value}</span></div>)}
      </div>
    </div>
  </div>
</section>
