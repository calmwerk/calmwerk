---
import Showcase from '../Showcase.astro';
---

<!-- Dunkler Einstieg: Aussage mittig, darunter die laufende Projektübersicht. -->
<section class="hero hero-dark" aria-labelledby="hero-title">
  <div class="wrap hero-center">
    <p class="label">Websites · Shops · Automatisierung · KI</p>
    <h1 id="hero-title">Digitale Systeme, <span class="quiet">die ruhig laufen.</span></h1>
    <p class="lede">Ihre Website oder Ihr Shop als Fundament, darauf Abläufe, die sich selbst erledigen: Terminbuchungen, Anfragen, Berichte.</p>
    <div class="ctas">
      <a class="btn light" href="#kontakt">Kostenloses Erstgespräch <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn ghost-light" href="#preise">Preise ansehen</a>
    </div>
  </div>
  <Showcase />
</section>
