---
import { site } from '../../data/site';

const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`Erstgespräch ${site.name}`)}`;
---

<section class="section dark contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="wrap">
    <div>
      <p class="label">Kontakt</p>
      <h2 id="kontakt-title">Lassen Sie uns 30 Minuten sprechen.</h2>
      <p class="lede">Erzählen Sie kurz, worum es geht. Sie erhalten innerhalb eines Werktags eine Antwort mit Terminvorschlägen für ein kostenloses Erstgespräch.</p>
      <a class="btn light" href={mailto}>E-Mail schreiben <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="contact-card">
      <div><span>E-Mail</span><span>{site.email} · <button class="copy" type="button" data-copy={site.email}>kopieren</button></span></div>
      <div><span>Termin</span><span>vor Ort in Karlsruhe oder online</span></div>
      <div><span>Antwort</span><span>innerhalb eines Werktags</span></div>
      <div><span>Region</span><span>{site.areaServed.join(', ')}</span></div>
    </div>
  </div>
</section>
