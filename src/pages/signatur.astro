---
/**
 * E-Mail-Signatur nach Markenentwurf 0.1: Name, Rolle, Kontaktzeile in Mono, Messing-Linie, Logo.
 * Logo unten: Werden Bilder blockiert, stehen Name und Kontakt trotzdem zuerst.
 * Nur Inline-Styles und Tabellen – E-Mail-Programme ignorieren Stylesheets und laden keine Webfonts.
 * Nicht in Suchmaschinen und nicht in der Sitemap.
 */
import LegalLayout from '../layouts/LegalLayout.astro';
import { site } from '../data/site';
import { absoluteUrl } from '../lib/url';

const logo = absoluteUrl('assets/img/signatur-logo.png');
const website = absoluteUrl();
const domain = 'calmwerk.de';
const rolle = `${site.founder.jobTitle} · Digitale Systeme`;

const sans = "Helvetica, Arial, sans-serif";
const mono = "Menlo, Consolas, 'Courier New', monospace";

// Alte HTML-Attribute, die Outlook für die Messing-Linie braucht (TypeScript kennt sie nicht mehr).
const outlookRule = { width: '48', height: '1', bgcolor: '#A6895B' };

const textVersion = `${site.founder.name}\n${rolle}\n${site.email} · ${domain} · ${site.address.locality}\n${site.name}`;
---

<LegalLayout title="E-Mail-Signatur – Calmwerk" description="E-Mail-Signatur von Calmwerk zum Kopieren." canonical={false}>
  <p class="label">Markenentwurf 0.1</p>
  <h1>E-Mail-Signatur</h1>
  <p>Signatur kopieren und im Mailprogramm einfügen. Das Logo wird von dieser Website geladen; sie muss also online bleiben.</p>

  <div class="sig-preview">
    <div id="signatur">
      <table cellpadding="0" cellspacing="0" border="0" role="presentation" style={`border-collapse:collapse;font-family:${sans};color:#111316;`}>
        <tr>
          <td style={`font-family:${sans};font-size:14px;line-height:20px;font-weight:bold;color:#111316;`}>{site.founder.name}</td>
        </tr>
        <tr>
          <td style={`padding:0 0 10px 0;font-family:${sans};font-size:13px;line-height:19px;color:#6E747A;`}>{rolle}</td>
        </tr>
        <tr>
          <td style={`padding:0 0 14px 0;font-family:${mono};font-size:12px;line-height:18px;color:#2B3036;`}>
            <a href={`mailto:${site.email}`} style="color:#2B3036;text-decoration:none;">{site.email}</a> · <a href={website} style="color:#2B3036;text-decoration:none;">{domain}</a> · {site.address.locality}
          </td>
        </tr>
        <tr>
          <td style="padding:0 0 14px 0;">
            <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="border-collapse:collapse;">
              <tr><td {...outlookRule} style="width:48px;height:1px;line-height:1px;font-size:1px;background-color:#A6895B;">&nbsp;</td></tr>
            </table>
          </td>
        </tr>
        <tr>
          <td>
            <a href={website} style="text-decoration:none;border:0;"><img src={logo} width="168" height="18" alt="Calmwerk" style="display:block;border:0;width:168px;height:18px;" /></a>
          </td>
        </tr>
      </table>
    </div>
  </div>

  <div class="sig-actions">
    <button class="btn" type="button" id="sig-copy">Signatur kopieren</button>
    <span class="mono" id="sig-status" role="status"></span>
  </div>

  <h2>Einrichten</h2>
  <dl class="sig-steps">
    <dt>Gmail</dt>
    <dd>Einstellungen (Zahnrad) → Alle Einstellungen → Allgemein → Signatur → Neu erstellen, einfügen, unten „Änderungen speichern“.</dd>
    <dt>Outlook (Web und neues Outlook)</dt>
    <dd>Einstellungen → Konto → Signaturen → Neue Signatur, einfügen, als Standard für neue Nachrichten und Antworten wählen, speichern.</dd>
    <dt>Outlook für Windows (klassisch)</dt>
    <dd>Datei → Optionen → E-Mail → Signaturen → Neu, einfügen, rechts als Standard wählen, OK.</dd>
    <dt>Apple Mail (Mac)</dt>
    <dd>Mail → Einstellungen → Signaturen → Account wählen → „+“, einfügen. Das Häkchen „Immer meiner Standardschrift entsprechen“ entfernen, sonst gehen Schriftgrößen und Farben verloren.</dd>
    <dt>Zoho Mail</dt>
    <dd>Einstellungen → Signatur → Neue Signatur hinzufügen, einfügen, dem Absender philipp@calmwerk.de zuordnen, speichern.</dd>
    <dt>iPhone (Mail-App)</dt>
    <dd>Einstellungen → Apps → Mail → Signatur. Die App speichert nur Text; dafür diese Version verwenden:
      <pre class="sig-text">{textVersion}</pre>
    </dd>
  </dl>

  <h2>HTML-Code</h2>
  <p>Für Programme, die eine HTML-Datei oder HTML-Code erwarten (z. B. Thunderbird: „Stattdessen eine Datei anhängen“ bzw. „HTML verwenden“):</p>
  <textarea class="sig-code" id="sig-code" readonly rows="8" aria-label="HTML-Code der Signatur"></textarea>
</LegalLayout>

<style is:global>
  .sig-preview { margin: 32px 0 20px; padding: 32px; background: #FFFFFF; border: 1px solid var(--hair); overflow-x: auto; }
  .sig-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .sig-steps { margin: 0; display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); border-top: 1px solid var(--hair); }
  .sig-steps dt, .sig-steps dd { margin: 0; padding: 14px 0; border-bottom: 1px solid var(--hair); }
  .sig-steps dt { font-weight: 500; padding-right: 16px; }
  .sig-steps dd { color: var(--graphite); }
  .sig-text { margin: 10px 0 0; padding: 12px 14px; background: var(--white); border: 1px solid var(--hair); font: 13px/1.6 var(--f-mono); white-space: pre-wrap; }
  .sig-code { width: 100%; margin-top: 12px; padding: 12px 14px; font: 12px/1.5 var(--f-mono); color: var(--graphite); background: var(--white); border: 1px solid var(--hair); resize: vertical; }
  @media (max-width: 640px) { .sig-steps { grid-template-columns: 1fr; } .sig-steps dt { border-bottom: 0; padding-bottom: 0; } }
</style>

<script>
  const signatur = document.getElementById('signatur');
  const button = document.getElementById('sig-copy');
  const status = document.getElementById('sig-status');
  const code = document.getElementById('sig-code') as HTMLTextAreaElement | null;

  if (signatur && code) code.value = signatur.innerHTML.trim();

  function selectSignature(): void {
    if (!signatur) return;
    const range = document.createRange();
    range.selectNodeContents(signatur);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  button?.addEventListener('click', async () => {
    if (!signatur || !status) return;
    const html = signatur.innerHTML.trim();
    try {
      await navigator.clipboard.write([
        new ClipboardItem({
          'text/html': new Blob([html], { type: 'text/html' }),
          'text/plain': new Blob([signatur.innerText], { type: 'text/plain' }),
        }),
      ]);
      status.textContent = 'Kopiert – jetzt im Mailprogramm einfügen.';
    } catch {
      // Ältere Browser: markieren und mit dem Systembefehl kopieren.
      selectSignature();
      const ok = document.execCommand('copy');
      status.textContent = ok ? 'Kopiert – jetzt im Mailprogramm einfügen.' : 'Signatur ist markiert – mit Strg+C bzw. ⌘+C kopieren.';
    }
  });
</script>
